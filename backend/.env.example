# Copy this file to .env and fill in credentials when integrating the providers.
INDIAN_KANOON_API_TOKEN=
INDIAN_KANOON_CUSTOMER=
INDIAN_KANOON_PRIVATE_KEY_PATH=
INDIAN_KANOON_BASE_URL=https://api.indiankanoon.org
INDIAN_KANOON_TIMEOUT_SECONDS=20
GNANI_API_KEY_ID=

# Any chat-completions-compatible LLM endpoint can be configured here.
# Example base URL format: https://provider.example/v1
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# Frontend origins accepted by FastAPI. Add the Vite origin if it differs.
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite:///./nyayaai.db
